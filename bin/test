#!/usr/bin/env bash
# Usage: bin/test unit|integration [files...] | bin/test down
set -euo pipefail
cd "$(dirname "$0")/.."

IMAGE=dolibarr/dolibarr:24.0.2-php8.5
COMPOSE=(docker compose -p dolimcp-test -f tests/compose.yaml)
suite="${1:-}"
[ $# -gt 0 ] && shift

case "$suite" in
  down)
    "${COMPOSE[@]}" down -v
    exit 0
    ;;
  unit|integration) ;;
  *)
    echo "Usage: bin/test unit|integration [files...] | bin/test down" >&2
    exit 2
    ;;
esac

if [ ! -d vendor ]; then
  docker run --rm -v "$PWD":/app -w /app composer:2 install --no-interaction --prefer-dist
fi

if [ "$suite" = unit ]; then
  exec docker run --rm -v "$PWD":/repo -w /repo --entrypoint php "$IMAGE" vendor/bin/phpunit --testsuite unit "$@"
fi

"${COMPOSE[@]}" up -d --wait
exec "${COMPOSE[@]}" run --rm tests vendor/bin/phpunit --testsuite integration "$@"
